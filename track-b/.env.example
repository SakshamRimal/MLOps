# Choose your provider: openai | vllm | ollama
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Used when provider is vllm or ollama
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Embedding & vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./data/chroma_db

# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# Retry settings
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.0
RETRY_MAX_WAIT=10.0

# Rate limiting (requests per minute per client)
RATE_LIMIT_PER_MINUTE=30

# Response cache
CACHE_MAX_SIZE=256
CACHE_TTL_SECONDS=300

# Fallback provider (optional - used when primary fails)
FALLBACK_PROVIDER=
FALLBACK_VLLM_BASE_URL=http://localhost:11434/v1
FALLBACK_VLLM_MODEL=llama3.2:3b
